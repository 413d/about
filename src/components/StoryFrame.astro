---
import type { NormalizedStory } from '@/lib/content';
import StoryContent from '@/components/StoryContent.astro';

interface Props {
	story: NormalizedStory;
	total: number;
	labelCounter: string;
	isActive: boolean;
	textModeHref: string;
	textModeLabel: string;
	emailLabel: string;
	flow: { api: string; queue: string; data: string };
}

const { story, total, labelCounter, isActive, textModeHref, textModeLabel, emailLabel, flow } = Astro.props;
---

<section
	data-story-item
	data-story-index={story.index}
	data-story-id={story.id}
	data-story-duration={story.durationMs}
	data-story-terminal={story.isTerminal ? 'true' : 'false'}
	data-active={isActive ? 'true' : 'false'}
	aria-hidden={isActive ? 'false' : 'true'}
	inert={!isActive}
	aria-label={`${labelCounter} ${story.index + 1} / ${total}: ${story.title}`}
	class="story-frame"
>
	<StoryContent
		story={story}
		textModeHref={textModeHref}
		textModeLabel={textModeLabel}
		emailLabel={emailLabel}
		flow={flow}
	/>
</section>
