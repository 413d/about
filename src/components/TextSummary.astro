---
import ContactLinks from '@/components/ContactLinks.astro';
import type { TextSummary as TextSummaryData } from '@/lib/content';

interface Props {
	summary: TextSummaryData;
}

const { summary } = Astro.props;
---

<main class="relative mx-auto w-full max-w-3xl px-6 py-10 sm:px-8">
	<header class="mb-8 rounded-[1.75rem] border border-slate-500/35 bg-slate-950/55 p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]">
		<p class="mb-3 text-[10px] font-bold uppercase tracking-[0.18em] text-amber-100/75">Profile</p>
		<h1 class="text-2xl font-semibold leading-tight text-slate-50 text-balance sm:text-3xl">{summary.title}</h1>
		<p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">{summary.intro}</p>
	</header>

	<div class="space-y-5">
		{summary.sections.map((section) => (
			<section class="rounded-[1.5rem] border border-slate-500/30 bg-slate-950/35 p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]">
				<h2 class="text-lg font-semibold text-slate-100">{section.title}</h2>
				<p class="mt-2 text-sm leading-relaxed text-slate-300">{section.summary}</p>
				{section.id === 'contact' && (
					<div class="mt-4">
						<ContactLinks variant="inline" qaPrefix="text-contact" />
					</div>
				)}
				{section.items && section.items.length > 0 && (
					<ul class="mt-3 space-y-2 text-sm text-slate-200">
						{section.items.map((item) => (
							<li class="border-l border-sky-200/25 pl-3">
								<span>{item.label}</span>
								{item.description && <span class="block text-slate-400">{item.description}</span>}
							</li>
						))}
					</ul>
				)}
			</section>
		))}
	</div>
</main>
