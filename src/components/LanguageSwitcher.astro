---
interface Props {
	lang: 'en' | 'ru';
	currentPathEn: string;
	currentPathRu: string;
	label: string;
}

const { lang, currentPathEn, currentPathRu, label } = Astro.props;
---

<nav aria-label={label} class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-slate-300">
	<a
		href={currentPathEn}
		data-qa="lang-en"
		hreflang="en"
		lang="en"
		aria-current={lang === 'en' ? 'page' : undefined}
		class:list={[
			'rounded-full border px-3 py-1.5 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-200',
			lang === 'en' ? 'border-amber-100 bg-amber-100 text-slate-950' : 'border-slate-500/65 bg-slate-950/20 hover:border-sky-200 hover:text-white'
		]}
	>
		EN
	</a>
	<a
		href={currentPathRu}
		data-qa="lang-ru"
		hreflang="ru"
		lang="ru"
		aria-current={lang === 'ru' ? 'page' : undefined}
		class:list={[
			'rounded-full border px-3 py-1.5 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-200',
			lang === 'ru' ? 'border-amber-100 bg-amber-100 text-slate-950' : 'border-slate-500/65 bg-slate-950/20 hover:border-sky-200 hover:text-white'
		]}
	>
		RU
	</a>
</nav>
