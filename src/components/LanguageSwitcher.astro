---
interface Props {
	lang: 'en' | 'ru';
	currentPathEn: string;
	currentPathRu: string;
	label: string;
}

const { lang, currentPathEn, currentPathRu, label } = Astro.props;

const pillBase = 'min-h-9 max-sm:min-h-11 inline-flex items-center rounded-full border px-3 py-1.5 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal';
const pillInactive = 'border-line-cold bg-ink/20 hover:border-signal hover:text-white';
const pillActive = 'border-instrument-soft bg-instrument-soft text-ink';
---

<nav aria-label={label} class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-slate-300">
	<a
		href={currentPathEn}
		data-qa="lang-en"
		hreflang="en"
		lang="en"
		aria-current={lang === 'en' ? 'page' : undefined}
		class:list={[pillBase, lang === 'en' ? pillActive : pillInactive]}
	>
		EN
	</a>
	<a
		href={currentPathRu}
		data-qa="lang-ru"
		hreflang="ru"
		lang="ru"
		aria-current={lang === 'ru' ? 'page' : undefined}
		class:list={[pillBase, lang === 'ru' ? pillActive : pillInactive]}
	>
		RU
	</a>
</nav>
