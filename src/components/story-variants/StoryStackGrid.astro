---
interface Props {
  lines: string[];
  stackItems?: string[];
}

const { lines, stackItems = [] } = Astro.props;
---

<div class="mt-5 space-y-3 text-sm leading-relaxed text-slate-300 sm:text-base">
  {lines.map((line) => <p>{line}</p>)}
</div>

{stackItems.length > 0 && (
  <ul class="mt-6 grid grid-cols-2 gap-2 text-xs text-slate-200 sm:grid-cols-3">
    {stackItems.map((item) => (
      <li class="rounded-full border border-sky-200/25 bg-sky-200/[0.06] px-3 py-1.5 text-center font-medium text-slate-100">{item}</li>
    ))}
  </ul>
)}
