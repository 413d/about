---
interface Props {
  lines: string[];
  highlightItems?: string[];
}

const { lines, highlightItems = [] } = Astro.props;
---

<div class="story-lines">
  {lines.map((line) => <p>{line}</p>)}
</div>

{highlightItems.length > 0 && (
  <ul class="story-highlights">
    {highlightItems.map((item) => <li>{item}</li>)}
  </ul>
)}
