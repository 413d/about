---
import { chipColumns } from '@/lib/chip-columns';

interface Props {
  lines: string[];
  stackItems?: string[];
  flow: { api: string; queue: string; data: string };
}

const { lines, stackItems = [], flow } = Astro.props;
const cols = chipColumns(stackItems.length);
---

<div class="story-lines">
  {lines.map((line) => <p>{line}</p>)}
</div>

<ul class="story-diagram" role="list">
  <li>{flow.api}</li>
  <li data-flow="warm">{flow.queue}</li>
  <li>{flow.data}</li>
</ul>

{stackItems.length > 0 && (
  <ul class="story-chips story-chips--muted" data-cols={cols ?? undefined}>
    {stackItems.map((item) => <li>{item}</li>)}
  </ul>
)}
