---
interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

<div class="mt-[clamp(0.75rem,3vw,1.5rem)] space-y-[clamp(0.5rem,2vw,0.75rem)]">
  {lines.map((line) => (
    <p class="rounded-2xl border border-sky-200/15 bg-slate-950/35 px-[clamp(0.75rem,3vw,1rem)] py-[clamp(0.5rem,2vw,0.75rem)] text-[clamp(0.75rem,2.5vw,0.875rem)] leading-relaxed text-slate-200 shadow-[inset_3px_0_0_rgba(125,211,252,0.38)] sm:text-base">{line}</p>
  ))}
</div>
