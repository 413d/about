---
interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

<div class="mt-[clamp(0.75rem,2.5vw,1.25rem)] space-y-[clamp(0.5rem,2vw,0.75rem)] text-[clamp(0.75rem,2.5vw,0.875rem)] leading-relaxed text-slate-300 sm:text-base">
  {lines.map((line) => <p>{line}</p>)}
</div>

<div class="mt-[clamp(0.75rem,3vw,1.5rem)] h-2 w-full overflow-hidden rounded-full bg-slate-800/80 ring-1 ring-white/5">
  <div class="h-full w-2/3 rounded-full bg-gradient-to-r from-sky-200 via-slate-50 to-amber-200"></div>
</div>
