---
interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

<div class="mt-5 space-y-3 text-sm leading-relaxed text-slate-300 sm:text-base">
  {lines.map((line) => <p>{line}</p>)}
</div>

<div class="mt-6 h-2 w-full overflow-hidden rounded-full bg-slate-800/80 ring-1 ring-white/5">
  <div class="h-full w-2/3 rounded-full bg-gradient-to-r from-sky-200 via-slate-50 to-amber-200"></div>
</div>
