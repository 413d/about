---
interface Props {
  lines: string[];
  highlightItems?: string[];
}

const { lines, highlightItems = [] } = Astro.props;
---

<div class="mt-[clamp(0.75rem,2.5vw,1.25rem)] space-y-[clamp(0.5rem,2vw,0.75rem)] text-[clamp(0.75rem,2.5vw,0.875rem)] leading-relaxed text-slate-300 sm:text-base">
  {lines.map((line) => <p>{line}</p>)}
</div>

{highlightItems.length > 0 && (
  <ul class="mt-[clamp(0.75rem,3vw,1.5rem)] grid grid-cols-1 gap-[clamp(0.25rem,1.25vw,0.5rem)] text-[clamp(0.75rem,2.5vw,0.875rem)] text-slate-200 sm:grid-cols-2">
    {highlightItems.map((item) => (
      <li class="rounded-2xl border border-slate-500/35 bg-slate-950/35 px-[clamp(0.5rem,2vw,0.75rem)] py-[clamp(0.375rem,1.5vw,0.5rem)] shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">{item}</li>
    ))}
  </ul>
)}
