---
import ContactLinks from '@/components/ContactLinks.astro';

interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

<div class="mt-[clamp(0.75rem,3vw,1.5rem)] space-y-[clamp(0.75rem,3vw,1rem)] border-l border-amber-200/45 pl-[clamp(0.75rem,3vw,1rem)] text-[clamp(0.875rem,3vw,1rem)] leading-relaxed text-slate-200">
  {lines.map((line) => (
    <p class="max-w-[45ch]">{line}</p>
  ))}
</div>

<div class="mt-[clamp(1rem,4vw,2rem)]">
  <ContactLinks variant="icons" qaPrefix="story-hero" />
</div>
