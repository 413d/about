---
import ContactLinks from '@/components/ContactLinks.astro';

interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

<div class="mt-6 space-y-4 border-l border-amber-200/45 pl-4 text-base leading-relaxed text-slate-200">
  {lines.map((line) => (
    <p class="max-w-[45ch]">{line}</p>
  ))}
</div>

<div class="mt-8">
  <ContactLinks variant="icons" qaPrefix="story-hero" />
</div>
