---
import ContactLinks from '@/components/ContactLinks.astro';

interface Props {
  lines: string[];
  lang?: 'en' | 'ru';
}

const { lines, lang = 'en' } = Astro.props;
---

<div class="story-lines story-lead">
  {lines.map((line) => <p>{line}</p>)}
</div>

<div class="mt-[var(--story-block-gap)]">
  <ContactLinks variant="icons" qaPrefix="story-hero" lang={lang} />
</div>
