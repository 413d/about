---
import type { NormalizedStory } from '@/lib/content';
import ContactLinks from '@/components/ContactLinks.astro';

interface Props {
	story: NormalizedStory;
	textModeHref: string;
	textModeLabel: string;
	emailLabel: string;
}

const { story, textModeHref, textModeLabel, emailLabel } = Astro.props;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const contactXUrl = import.meta.env.PUBLIC_CONTACT_X_URL;
const contactGithubUrl = import.meta.env.PUBLIC_CONTACT_GITHUB_URL;
const hasContact = Boolean(contactEmail || contactXUrl || contactGithubUrl);
---

<div class="flex min-h-0 flex-1 flex-col pt-[clamp(0.75rem,2.5vw,1.25rem)]">
	<div class="space-y-[clamp(0.5rem,2vw,0.75rem)] text-[clamp(0.875rem,2.5vw,1rem)] leading-relaxed text-slate-300">
		{story.lines.map((line) => <p>{line}</p>)}
	</div>

	<div class="mt-auto pt-[clamp(1.5rem,6vw,3rem)]">
		<a
			href={textModeHref}
			data-qa="story-cta-summary"
			class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-amber-100/70 bg-amber-200/15 px-5 py-2.5 text-center text-[11px] font-semibold uppercase tracking-[0.1em] text-amber-50 transition hover:border-amber-100 hover:bg-amber-200/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-100"
		>
			{textModeLabel}
		</a>

		{hasContact && (
			<div class="mt-3 flex flex-wrap items-center gap-3">
				{contactEmail && (
					<a
						href={`mailto:${contactEmail}`}
						data-story-cta
						data-qa="story-cta-email"
						class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-500/60 bg-slate-950/25 px-5 py-2.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-200 transition hover:border-sky-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-200"
					>
						{emailLabel}
					</a>
				)}
				<ContactLinks variant="icons" qaPrefix="story-cta" excludeEmail />
			</div>
		)}
	</div>
</div>
