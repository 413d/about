---
import type { NormalizedStory } from '@/lib/content';
import ContactLinks from '@/components/ContactLinks.astro';

interface Props {
	story: NormalizedStory;
	textModeHref: string;
	textModeLabel: string;
	emailLabel: string;
	lang?: 'en' | 'ru';
}

const { story, textModeHref, textModeLabel, emailLabel, lang = story.lang } = Astro.props;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const contactXUrl = import.meta.env.PUBLIC_CONTACT_X_URL;
const contactGithubUrl = import.meta.env.PUBLIC_CONTACT_GITHUB_URL;
const hasContact = Boolean(contactEmail || contactXUrl || contactGithubUrl);
---

<div class="story-lines">
	{story.lines.map((line) => <p>{line}</p>)}
</div>

<div class="story-actions">
	<a
		href={textModeHref}
		data-qa="story-cta-summary"
		class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-instrument-soft/70 bg-instrument/15 px-5 py-2.5 text-center text-[11px] font-semibold uppercase tracking-[0.1em] text-instrument-soft transition hover:border-instrument-soft hover:bg-instrument/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-instrument-soft"
	>
		{textModeLabel}
	</a>

	{hasContact && (
		<div class="flex flex-wrap items-center gap-3">
			{contactEmail && (
				<a
					href={`mailto:${contactEmail}`}
					data-story-cta
					data-qa="story-cta-email"
					class="inline-flex min-h-11 items-center justify-center rounded-full border border-line-cold bg-ink/25 px-5 py-2.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-200 transition hover:border-signal hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
				>
					{emailLabel}
				</a>
			)}
			<ContactLinks variant="icons" qaPrefix="story-cta" excludeEmail lang={lang} />
		</div>
	)}
</div>
