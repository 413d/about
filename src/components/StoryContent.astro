---
import type { NormalizedStory } from '@/lib/content';
import StoryHero from '@/components/story-variants/StoryHero.astro';
import StoryTextEmphasis from '@/components/story-variants/StoryTextEmphasis.astro';
import StoryStackGrid from '@/components/story-variants/StoryStackGrid.astro';
import StorySystemsDiagram from '@/components/story-variants/StorySystemsDiagram.astro';
import StoryProblemCards from '@/components/story-variants/StoryProblemCards.astro';
import StoryLeadershipSignals from '@/components/story-variants/StoryLeadershipSignals.astro';
import StoryGrowthPath from '@/components/story-variants/StoryGrowthPath.astro';
import StoryCtaBlock from '@/components/story-variants/StoryCtaBlock.astro';

interface Props {
	story: NormalizedStory;
}

const { story } = Astro.props;

const variantClass: Record<NormalizedStory['visualVariant'], string> = {
	'hero': 'from-slate-800/95 via-slate-950/96 to-slate-950',
	'text-emphasis': 'from-slate-950 via-slate-900/95 to-slate-950',
	'stack-grid': 'from-[#101a2a] via-slate-950 to-slate-950',
	'systems-diagram': 'from-[#0b1720] via-slate-950 to-[#100f19]',
	'problem-cards': 'from-[#111827] via-slate-950 to-[#17111f]',
	'leadership-signals': 'from-[#101725] via-slate-950 to-[#07111c]',
	'growth-path': 'from-[#101a21] via-slate-950 to-[#17120a]',
	'cta-block': 'from-slate-950 via-[#111827] to-[#1c1308]'
};
---

<article class:list={['relative h-full overflow-x-hidden overflow-y-hidden rounded-[2rem] border border-slate-500/35 bg-gradient-to-br p-[clamp(1rem,4vw,2rem)] shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]', variantClass[story.visualVariant]]}>
	<div class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:38px_38px] opacity-35"></div>
	<div class="pointer-events-none absolute -right-20 -top-20 h-44 w-44 rounded-full border border-amber-200/20"></div>
	<div class="pointer-events-none absolute bottom-8 right-8 h-px w-24 bg-gradient-to-r from-transparent via-sky-200/50 to-transparent"></div>

	<div class="relative">
		<p class="text-[clamp(0.5rem,1.5vw,0.625rem)] font-bold uppercase tracking-[0.18em] text-amber-100/75">{story.eyebrow}</p>
		<h2 class="mt-[clamp(0.375rem,1.5vw,0.75rem)] text-[clamp(1.25rem,5vw,1.875rem)] font-semibold leading-[1.08] text-slate-50 text-balance sm:text-3xl">{story.title}</h2>

		{story.visualVariant === 'hero' && <StoryHero lines={story.lines} />}
		{story.visualVariant === 'text-emphasis' && <StoryTextEmphasis lines={story.lines} />}
		{story.visualVariant === 'stack-grid' && <StoryStackGrid lines={story.lines} stackItems={story.stackItems} />}
		{story.visualVariant === 'systems-diagram' && <StorySystemsDiagram lines={story.lines} stackItems={story.stackItems} />}
		{story.visualVariant === 'problem-cards' && <StoryProblemCards lines={story.lines} highlightItems={story.highlightItems} />}
		{story.visualVariant === 'leadership-signals' && (
			<StoryLeadershipSignals lines={story.lines} highlightItems={story.highlightItems} />
		)}
		{story.visualVariant === 'growth-path' && <StoryGrowthPath lines={story.lines} />}
		{story.visualVariant === 'cta-block' && <StoryCtaBlock lines={story.lines} />}
	</div>
</article>
