---
import type { NormalizedStory } from '@/lib/content';
import StoryHero from '@/components/story-variants/StoryHero.astro';
import StoryTextEmphasis from '@/components/story-variants/StoryTextEmphasis.astro';
import StoryStackGrid from '@/components/story-variants/StoryStackGrid.astro';
import StorySystemsDiagram from '@/components/story-variants/StorySystemsDiagram.astro';
import StoryProblemCards from '@/components/story-variants/StoryProblemCards.astro';
import StoryLeadershipSignals from '@/components/story-variants/StoryLeadershipSignals.astro';
import StoryGrowthPath from '@/components/story-variants/StoryGrowthPath.astro';
import StoryCtaBlock from '@/components/story-variants/StoryCtaBlock.astro';

interface Props {
	story: NormalizedStory;
	textModeHref: string;
	textModeLabel: string;
	emailLabel: string;
	flow: { api: string; queue: string; data: string };
}

const { story, textModeHref, textModeLabel, emailLabel, flow } = Astro.props;

const isTerminal = story.visualVariant === 'cta-block';
---

<article data-variant={story.visualVariant} class="story-card">
	<div class="story-decor pointer-events-none absolute inset-0">
		<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:38px_38px] opacity-35"></div>
		<div class="story-decor-arc absolute rounded-full border border-instrument/20"></div>
		<div class="story-decor-hairline absolute bottom-[8%] right-[6%] h-px w-24 bg-gradient-to-r from-transparent via-signal/50 to-transparent"></div>
	</div>

	<div class:list={['story-card-body', isTerminal && 'flex-1']}>
		{!isTerminal && <p class="story-eyebrow">{story.eyebrow}</p>}
		<h2 class="story-title">{story.title}</h2>

		{story.visualVariant === 'hero' && <StoryHero lines={story.lines} lang={story.lang} />}
		{story.visualVariant === 'text-emphasis' && <StoryTextEmphasis lines={story.lines} />}
		{story.visualVariant === 'stack-grid' && <StoryStackGrid lines={story.lines} stackItems={story.stackItems} />}
		{story.visualVariant === 'systems-diagram' && (
			<StorySystemsDiagram lines={story.lines} stackItems={story.stackItems} flow={flow} />
		)}
		{story.visualVariant === 'problem-cards' && <StoryProblemCards lines={story.lines} highlightItems={story.highlightItems} />}
		{story.visualVariant === 'leadership-signals' && (
			<StoryLeadershipSignals lines={story.lines} highlightItems={story.highlightItems} />
		)}
		{story.visualVariant === 'growth-path' && <StoryGrowthPath lines={story.lines} />}
		{story.visualVariant === 'cta-block' && (
			<StoryCtaBlock
				story={story}
				textModeHref={textModeHref}
				textModeLabel={textModeLabel}
				emailLabel={emailLabel}
			/>
		)}
	</div>
</article>
