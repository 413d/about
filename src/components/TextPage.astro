---
import Layout from '@/layouts/Layout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import TextSummary from '@/components/TextSummary.astro';
import TextModeLink from '@/components/TextModeLink.astro';
import TextFooter from '@/components/TextFooter.astro';
import type { AppLang } from '@/lib/content';
import { getTextSummaryByLang } from '@/lib/content';
import { getAlternatePaths, getModePath, getPageMeta, getUiLabels } from '@/lib/i18n';

interface Props {
	lang: AppLang;
}

const { lang } = Astro.props;
const summary = await getTextSummaryByLang(lang);
const meta = getPageMeta(lang, 'text');
const labels = getUiLabels(lang);
const alternates = getAlternatePaths(lang, 'text');
const homeHref = getModePath(lang, 'stories');
const homeLabel = lang === 'ru' ? 'На главную' : 'Go to home';
---

<Layout lang={lang} title={meta.title} description={meta.description} canonicalPath={getModePath(lang, 'text')} alternatePaths={alternates} mode="text">
	<div class="story-shell mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 pt-6 sm:px-6 sm:pt-8">
		<div class="flex items-center gap-3">
			<a href={homeHref} aria-label={homeLabel} class="grid h-9 w-9 place-items-center rounded-full border border-amber-100/40 bg-amber-100/10 text-[11px] font-bold leading-none tracking-[0.08em] text-amber-50 transition hover:border-amber-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-100">LX</a>
			<LanguageSwitcher lang={lang} currentPathEn={alternates.en} currentPathRu={alternates.ru} label={labels.jumpToLanguage} />
		</div>
		<TextModeLink href={getModePath(lang, 'stories')} label={labels.backToStories} qa="back-to-stories" targetMode="stories" />
	</div>
	<TextSummary summary={summary} />
	<TextFooter lang={lang} />
</Layout>
