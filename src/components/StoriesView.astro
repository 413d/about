---
import type { NormalizedStory } from '@/lib/content';
import type { UiLabels } from '@/lib/i18n';
import { getModePath } from '@/lib/i18n';
import StoryFrame from '@/components/StoryFrame.astro';
import StoryProgressRail from '@/components/StoryProgressRail.astro';

interface Props {
	lang: 'en' | 'ru';
	stories: NormalizedStory[];
	uiLabels: UiLabels;
}

const { lang, stories, uiLabels } = Astro.props;
const textModeHref = getModePath(lang, 'text');
const flow = { api: uiLabels.flowApi, queue: uiLabels.flowQueue, data: uiLabels.flowData };
---

<section
	data-story-root
	data-qa="story-root"
	data-story-count={stories.length}
	data-story-lang={lang}
	data-story-initial-index="0"
	data-story-layout="stage"
	data-story-counter-label={uiLabels.storyCounter}
	tabindex="0"
	role="region"
	aria-label={uiLabels.storyExperienceLabel}
	aria-describedby="story-key-hints"
	class="mx-auto flex w-full max-w-md flex-col gap-3 focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-signal sm:gap-4"
>
	<StoryProgressRail count={stories.length} />

	<div class="story-stage relative min-h-0 rounded-[2rem] shadow-[0_28px_90px_rgba(0,0,0,0.34)]" data-story-stage>
		{stories.map((story, idx) => (
			<StoryFrame
				story={story}
				total={stories.length}
				labelCounter={uiLabels.storyCounter}
				isActive={idx === 0}
				textModeHref={textModeHref}
				textModeLabel={uiLabels.readTextSummary}
				emailLabel={uiLabels.emailAlex}
				flow={flow}
			/>
		))}

		<div class="pointer-events-none absolute inset-x-0 top-0 z-10 grid h-3/5 grid-cols-[1fr_1fr_1fr] rounded-t-[2rem]" aria-hidden="true">
			<div class="pointer-events-auto h-full w-full cursor-pointer" data-story-hitzone="prev"></div>
			<div class="pointer-events-auto h-full w-full cursor-pointer" data-story-hitzone="pause"></div>
			<div class="pointer-events-auto h-full w-full cursor-pointer" data-story-hitzone="next"></div>
		</div>
	</div>

	<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
		<p class="story-counter text-xs font-medium text-slate-300" data-story-counter data-qa="story-counter">{uiLabels.storyCounter} 1 / {stories.length}</p>
		<div class="flex gap-2">
			<button type="button" data-story-nav="prev" data-story-control="button" data-qa="story-prev" class="min-h-9 max-sm:min-h-11 rounded-full border border-line-cold bg-ink/25 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-300 transition hover:border-signal hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal">{uiLabels.prev}</button>
			<button type="button" data-story-nav="pause" data-story-control="button" data-qa="story-pause" class="min-h-9 max-sm:min-h-11 rounded-full border border-instrument/45 bg-instrument/10 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-instrument-soft transition hover:border-instrument hover:bg-instrument/18 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-instrument-soft" data-story-pause-label={uiLabels.pause} data-story-resume-label={uiLabels.resume} data-story-start-over-label={uiLabels.startOver}>{uiLabels.pause}</button>
			<button type="button" data-story-nav="next" data-story-control="button" data-qa="story-next" class="min-h-9 max-sm:min-h-11 rounded-full border border-line-cold bg-ink/25 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-300 transition hover:border-signal hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-45 disabled:hover:border-line-cold disabled:hover:text-slate-300">{uiLabels.next}</button>
		</div>
	</div>

	<p id="story-key-hints" class="sr-only">{uiLabels.keyHints}</p>
	<p class="sr-only" data-story-live-region aria-live="polite"></p>

	<noscript>
		<p class="rounded-xl border border-line-cold bg-ink/60 px-4 py-3 text-sm text-slate-300">
			{uiLabels.noJsHint}
		</p>
	</noscript>
</section>

<script>
	import { mountStoryController } from '@/scripts/story-controller';

	function init() {
		const roots = document.querySelectorAll('[data-story-root]');
		const cleanups = Array.from(roots, (root) => mountStoryController(root));

		document.addEventListener('astro:before-swap', () => {
			cleanups.forEach((cleanup) => {
				cleanup();
			});
		}, { once: true });
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>
